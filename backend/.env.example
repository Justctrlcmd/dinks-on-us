APP_NAME="Dinks on Us"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000
FACEBOOK_URL="https://www.facebook.com/dinksonus"
BUSINESS_TIMEZONE=Asia/Manila

# Local development manager seeded by `php artisan db:seed`.
MANAGER_NAME="Dinks on Us Manager"
MANAGER_EMAIL=manager@dinksonus.test
MANAGER_PASSWORD="DinksManager2026!"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
# Keep false while legacy bcrypt accounts are upgraded on successful login.
# Set true after every stored user password is Argon2id.
HASH_VERIFY=false
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dinks_on_us
DB_USERNAME=dinks_on_us_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:*,127.0.0.1:*

# Comma-separated exact proxy IP/CIDR values and host regex patterns. Leave empty locally.
TRUSTED_PROXIES=
TRUSTED_HOSTS=
SECURITY_HSTS_ENABLED=false

# Tune these only after production load testing. Multi-instance deployments need an atomic shared cache.
RATE_LIMIT_API_PER_MINUTE=180
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120
RATE_LIMIT_MANAGEMENT_PER_MINUTE=90
RATE_LIMIT_PUBLIC_READ_PER_MINUTE=90
RATE_LIMIT_RESERVATION_OPTIONS_PER_MINUTE=45
RATE_LIMIT_RESERVATION_SUBMIT_PER_MINUTE=10
RATE_LIMIT_RESERVATION_SUBMIT_PER_HOUR=30
RATE_LIMIT_RESERVATION_IDENTITY_PER_HOUR=10
RATE_LIMIT_LOGIN_ACCOUNT_PER_MINUTE=5
RATE_LIMIT_LOGIN_IP_PER_MINUTE=20
RATE_LIMIT_REPORTS_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_MINUTE=20
RATE_LIMIT_PROOF_DOWNLOADS_PER_MINUTE=60
RATE_LIMIT_DESTRUCTIVE_PER_MINUTE=10
RATE_LIMIT_PROOF_CLEANUP_PER_MINUTE=2

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dinks-on-us.test"
MAIL_FROM_NAME="${APP_NAME}"
RESERVATION_EMAILS_ENABLED=false

# Web Push is opt-in. Generate a VAPID key pair before enabling in production.
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_VAPID_SUBJECT="mailto:hello@dinksonus.test"
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
