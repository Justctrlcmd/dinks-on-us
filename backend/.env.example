APP_NAME="Dinks on Us"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000
FACEBOOK_URL="https://www.facebook.com/profile.php?id=61593085117097"

# Local development manager seeded by `php artisan db:seed`.
MANAGER_NAME="Dinks on Us Manager"
MANAGER_EMAIL=manager@dinksonus.test
MANAGER_PASSWORD="DinksManager2026!"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dinks_on_us
DB_USERNAME=dinks_on_us_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:*,127.0.0.1:*

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dinks-on-us.test"
MAIL_FROM_NAME="${APP_NAME}"
RESERVATION_EMAILS_ENABLED=false

# Web Push is opt-in. Generate a VAPID key pair before enabling in production.
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_VAPID_SUBJECT="mailto:hello@dinksonus.test"
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
